# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Only the accounts layer reads any of this. The registry is static files and
# needs none of it, so `npm run build:registry`, the CLI, and every public page
# work with this file absent.

# Local Postgres from docker-compose.yml. Host port is 5433 rather than 5432 so
# it cannot collide with a Postgres you already run.
DATABASE_URL=postgres://nodex:nodex@localhost:5433/nodex

# GitHub OAuth app: https://github.com/settings/developers
#
# Register a new OAuth App with:
#   Homepage URL:               http://localhost:4180
#   Authorization callback URL: http://localhost:4180/api/auth/github/callback
#
# The secret is a real credential. If it is ever pasted somewhere public, rotate
# it in GitHub rather than deleting the message.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where the OAuth callback comes back to. Must match the app's callback URL host.
NEXT_PUBLIC_SITE_URL=http://localhost:4180

# Optional. Serve the registry from a CDN instead of the app's own public/.
# NEXT_PUBLIC_REGISTRY_URL=
