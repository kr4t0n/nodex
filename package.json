{
  "name": "nodex",
  "version": "0.1.0",
  "private": true,
  "description": "A design-language-first component registry",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:registry": "node scripts/build-registry.ts",
    "build:cli": "npm run build --workspace @kubitnodes/nodex",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "check:registry": "node scripts/build-registry.ts --check",
    "check:shell": "node scripts/check-shell-primitives.mjs",
    "smoke": "node scripts/smoke-components.ts",
    "typecheck": "tsc --build && tsc --noEmit -p registry/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && npm run typecheck --workspace @nodex/web",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "dev": "npm run dev --workspace @nodex/web",
    "smoke:cli": "node scripts/smoke-cli.ts",
    "smoke:landing": "node scripts/smoke-landing.ts",
    "build": "npm run build:registry && npm run build --workspace @nodex/web",
    "start": "npm run start --workspace @nodex/web",
    "test": "node --test scripts/registry.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "d3-hierarchy": "3.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.3",
    "@next/swc-linux-x64-gnu": "16.3.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
