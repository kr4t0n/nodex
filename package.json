{
  "name": "nodex",
  "version": "0.1.0",
  "private": true,
  "description": "A design-language-first component registry",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "husky",
    "build:registry": "node scripts/build-registry.ts",
    "build:cli": "pnpm --filter @kubitnodes/nodex run build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "check:registry": "node scripts/build-registry.ts --check",
    "check:shell": "node scripts/check-shell-primitives.mjs",
    "smoke": "node scripts/smoke-components.ts",
    "typecheck": "tsc --build && tsc --noEmit -p registry/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && pnpm --filter @nodex/web run typecheck",
    "lint": "oxlint . --max-warnings 0 && eslint . --max-warnings 0",
    "lint:fix": "oxlint --fix . --max-warnings 0 && eslint --fix . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @nodex/web run dev",
    "smoke:cli": "node scripts/smoke-cli.ts",
    "smoke:pack": "node scripts/smoke-packed-cli.ts",
    "smoke:landing": "node scripts/smoke-landing.ts",
    "smoke:gallery": "node scripts/smoke-gallery.ts",
    "build": "pnpm run build:registry && pnpm --filter @nodex/web run build",
    "start": "pnpm --filter @nodex/web run start",
    "test": "node --test scripts/registry.test.ts scripts/lint.test.ts && pnpm run test:auth",
    "test:auth": "node --test scripts/device-*.test.ts scripts/oauth.test.ts scripts/token-route.test.ts scripts/migrate-errors.test.ts",
    "test:auth:postgres": "node --test scripts/auth-postgres.test.ts"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/gaegu": "5.3.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/parser": "8.67.0",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.9.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "roughjs": "4.6.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "pg": "8.23.0"
  }
}
