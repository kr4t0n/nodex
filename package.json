{
  "name": "nodex",
  "version": "0.1.0",
  "private": true,
  "description": "A design-language-first component registry",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:registry": "node scripts/build-registry.mjs",
    "check:registry": "node scripts/build-registry.mjs --check",
    "smoke": "node scripts/smoke-components.mjs",
    "typecheck": "tsc --build && npm run typecheck --workspace @nodex/gallery",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "dev": "npm run dev --workspace @nodex/gallery",
    "smoke:cli": "node scripts/smoke-cli.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
