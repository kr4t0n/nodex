# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# generated registry artifacts — authored registry/ contains source only
public/r/
public/registry/

# env — never commit secrets
.env
.env.*
!.env.example

# editor / os
.DS_Store
*.log
.turbo/
.argus/

# next
apps/web/.next/
apps/web/next-env.d.ts

# registry copied into the web app by scripts/sync-registry-public.ts so Next
# can serve it from public/ — always regenerated, never a source of truth
apps/web/public/
# Lazy example imports generated alongside the public registry sync.
apps/web/src/generated/
