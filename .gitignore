# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# generated registry artifacts — authored registry/ contains source only
public/r/
public/registry/

# scratch space. The one-shot extractor lived here and was deleted once its
# output was verified; recover it from git history if a chart's provenance is
# ever in question (see AGENTS.md).
tmp/

# env — never commit secrets
.env
.env.*
!.env.example

# editor / os
.DS_Store
*.log
.turbo/
.argus/

# next
apps/web/.next/
apps/web/next-env.d.ts

# registry copied into the web app by scripts/sync-registry-public.ts so Next
# can serve it from public/ — always regenerated, never a source of truth
apps/web/public/
