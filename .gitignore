# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# generated registry artifacts — rebuilt by scripts/build-registry.mjs
registry/**/index.html
registry/languages/*/tokens.css
public/r/

# scratch space. The one-shot extractor lived here and was deleted once its
# output was verified; recover it from git history if a chart's provenance is
# ever in question (see AGENTS.md).
tmp/

# env — never commit secrets
.env
.env.*
!.env.example

# editor / os
.DS_Store
*.log
.turbo/

# next
apps/web/.next/
apps/web/next-env.d.ts

# registry copied into the web app by scripts/sync-registry-public.mjs so Next
# can serve it from public/ — always regenerated, never a source of truth
apps/web/public/
