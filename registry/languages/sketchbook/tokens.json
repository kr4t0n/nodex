  "$comment": "Sketchbook: roughViz-derived drawing tokens plus explicitly designed Nodex UI roles. Provenance and pinned source references are in PROVENANCE.md.",
  "sketch": {
    "$comment": "roughViz Bar roughness, axisRoughness, bowing and fillWeight; explicit Rough.js hachure defaults. Numeric values are resolved in the chart scope.",
    "roughness": 1,
    "axisRoughness": 0.5,
    "bowing": 0,
    "fillStyle": "hachure",
    "fillWeight": 0.5,
    "hachureAngle": -41,
    "hachureGap": 4
  },
  "texture": {
    "outlineOpacity": 0.4,
    "outlineInset": "1px 2px 2px 1px",
    "outlineRadius": "7px 4px 8px 3px / 3px 8px 4px 7px",
    "hatchOpacity": 0.18,
    "hatchSize": "24px",
    "hatchGap": "5px",
    "hatchAngle": "-41deg"
