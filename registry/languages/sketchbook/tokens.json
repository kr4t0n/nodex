  "motion": {
    "draw": {
      "duration": "0.35s",
      "easing": "ease-out"
    },
    "pop": {
      "duration": "0.5s",
      "easing": "cubic-bezier(.2,.7,.3,1.3)"
    },
    "fade": {
      "duration": "0.9s",
      "easing": "ease"
    },
    "revealThreshold": 0.3,
    "control": {
      "duration": "160ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "toggle": {
      "duration": "140ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "mark": {
      "duration": "140ms",
      "easing": "cubic-bezier(.2,.7,.3,1.3)"
    },
    "press": {
      "duration": "120ms",
      "easing": "cubic-bezier(.4,0,.2,1)",
      "x": "0px",
      "y": "1px"
    },
    "surface": {
      "duration": "180ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "disclosure": {
      "duration": "200ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "progress": {
      "duration": "320ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "tooltip": {
      "duration": "140ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    }
