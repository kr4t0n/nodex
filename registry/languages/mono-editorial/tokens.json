{
  "$comment": "Canonical language values. The registry build generates tokens.css; primitives and charts consume its semantic variables directly.",
  "color": {
    "bg": "#F0EFEB",
    "paper": "#F0EFEB",
    "ink": "#1C1C1A",
    "dark": "#1C1C1A",
    "muted": "#8F8E88",
    "faint": "#C6C5BF",
    "grid": "#DEDDD6",
    "onDarkMuted": "#8F8E88",
    "onDarkFaint": "#55554F",
    "markQuiet": "#B0AFA9",
    "markStrong": "#4A4944",
    "markMuted": "#6A6963",
    "plotTrack": "#E4E3DD",
    "plotGrid": "#E3E2DB",
    "plotFaint": "#D8D6CE",
    "plotFloor": "#CFCEC7"
  },
  "ramp": {
    "$comment": "Preserved language colors and the chart paints used by the retained specimens. Chart paint is authored through semantic roles above; unused legacy shades are omitted.",
    "steps": [
      "#F0EFEB",
      "#E4E3DD",
      "#E3E2DB",
      "#DEDDD6",
      "#D8D6CE",
      "#CFCEC7",
      "#C6C5BF",
      "#B0AFA9",
      "#8F8E88",
      "#6A6963",
      "#55554F",
      "#4A4944",
      "#1C1C1A"
    ]
  },
  "stroke": {
    "$comment": "Sub-pixel hairlines are the single strongest signature of this language. lineMax applies to anything that reads as a line; ribbon and band charts, where the stroke IS the area and its width encodes magnitude, are exempt.",
    "scale": [
      "0.5px",
      "0.6px",
      "0.7px",
      "0.8px",
      "0.9px",
      "1px",
      "1.1px"
    ],
    "hairline": "0.7px",
    "mark": "1px",
    "emphasis": "1.1px",
    "lineMax": "1.4px",
    "bandExempt": true
  },
  "radius": {
    "card": "24px",
    "pill": "99px",
    "checkbox": "3px",
    "code": "4px",
    "tooltip": "6px",
    "focus": "2px"
  },
  "font": {
    "sans": "'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif",
    "$comment": "Monospace was in use before it was a token: the gallery hand-styled inline code and the nodex add command row. Naming it here makes the code and prose primitives themeable rather than hardcoding a stack.",
    "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "weights": [
      400,
      500,
      600,
      700,
      800
    ],
    "faces": [
      {
        "package": "@fontsource-variable/inter@5.3.0",
        "file": "files/inter-latin-wght-normal.woff2",
        "family": "Inter",
        "weight": "100 900",
        "style": "normal"
      }
    ],
    "weight": {
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "type": {
    "plotValue": {
      "size": "17px",
      "weight": 700
    },
    "pageTitle": {
      "size": "22px",
      "weight": 800,
      "tracking": "-0.02em"
    },
    "cardTitle": {
      "size": "16.5px",
      "weight": 700,
      "tracking": "-0.02em"
    },
    "subtitle": {
      "size": "11.5px",
      "weight": 400,
      "color": "muted",
      "lineHeight": 1.5
    },
    "note": {
      "size": "11px",
      "lineHeight": 1.65
    },
    "legend": {
      "size": "9px",
      "weight": 600,
      "tracking": "0.1em"
    },
    "caption": {
      "size": "9.5px",
      "weight": 500,
      "tracking": "0.08em"
    },
    "axis": {
      "size": "8px",
      "weight": 600
    },
    "action": {
      "size": "11.5px",
      "weight": 600,
      "tracking": "0.01em",
      "lineHeight": 1
    },
    "control": {
      "size": "12px",
      "lineHeight": 1.4,
      "multilineLineHeight": 1.65
    },
    "label": {
      "size": "9px",
      "weight": 700,
      "tracking": "0.08em"
    },
    "body": {
      "size": "11.5px",
      "lineHeight": 1.7
    },
    "help": {
      "size": "10.5px",
      "lineHeight": 1.5
    },
    "badge": {
      "lineHeight": 1.6
    },
    "disclosure": {
      "size": "12.5px",
      "weight": 600,
      "lineHeight": 1.5,
      "bodyLineHeight": 1.75
    },
    "emptyTitle": {
      "size": "15px"
    },
    "avatar": {
      "size": "10px",
      "smallSize": "8px",
      "largeSize": "13px",
      "countSize": "9px",
      "tracking": "0.04em"
    },
    "code": {
      "inlineSize": "0.88em",
      "keySize": "0.82em",
      "keyLineHeight": 1.5,
      "blockSize": "11px",
      "blockLineHeight": 1.7,
      "commandSize": "11.5px",
      "commandLineHeight": 1.6
    },
    "prose": {
      "size": "12.5px",
      "lineHeight": 1.75,
      "titleSize": "19px",
      "titleWeight": 800,
      "headingTracking": "-0.02em",
      "sectionSize": "13px",
      "sectionTracking": "0.06em",
      "subheadingSize": "12.5px",
      "minorHeadingSize": "12px",
      "narrowSize": "11px",
      "narrowLineHeight": 1.7
    },
    "stat": {
      "size": "26px",
      "smallSize": "18px",
      "largeSize": "38px",
      "tracking": "-0.03em",
      "smallTracking": "-0.02em",
      "largeTracking": "-0.035em",
      "lineHeight": 1.05,
      "unitSize": "0.55em",
      "deltaSize": "10.5px"
    },
    "status": {
      "size": "11px",
      "lineHeight": 1.4
    },
    "tooltip": {
      "size": "10.5px",
      "weight": 500,
      "lineHeight": 1.45,
      "tracking": "0.01em"
    }
  },
  "space": {
    "cardPadding": "28px 28px 20px",
    "gridGap": "22px",
    "pagePadding": "40px",
    "fieldGap": "6px",
    "controlPadding": "0.6em 0.95em",
    "textareaPadding": "0.7em 0.95em",
    "actionPadding": "0.55em 1.1em",
    "actionGap": "0.5em",
    "quietActionPaddingInline": "0.5em",
    "compactActionPadding": "0.5em 1em",
    "choiceGap": "0.65em",
    "choiceGroupGap": "0.7em",
    "choiceRowGap": "1.1em",
    "choiceSpreadGap": "1.5em",
    "labelValueGap": "1em",
    "badgePadding": "3px 10px",
    "badgeGap": "0.4em",
    "cardBodyGap": "14px",
    "captionGap": "12px",
    "subtitleGap": "3px",
    "alertPadding": "12px 0 12px 14px",
    "alertGap": "0.35em",
    "avatarOverlap": "8px",
    "inlineCodePadding": "0.15em 0.4em",
    "keyPadding": "0.1em 0.4em",
    "codeBlockPadding": "14px 16px",
    "commandPadding": "0.55em 0.9em",
    "commandGap": "0.8em",
    "disclosurePadding": "12px 0",
    "disclosureGap": "0.8em",
    "disclosureBodyPadding": "0 0 16px",
    "dialogBodyPadding": "22px 24px 20px",
    "dialogActionsPadding": "14px 24px",
    "dialogGap": "8px",
    "emptyPadding": "30px 28px",
    "emptyCenteredPadding": "52px 28px",
    "emptyQuietPadding": "20px 0",
    "emptyGap": "10px",
    "emptyActionGap": "4px",
    "linkUnderlineOffset": "0.22em",
    "linkIconGap": "0.35em",
    "proseFlowGap": "0.9em",
    "proseSectionGap": "2em",
    "proseSubheadingGap": "1.6em",
    "proseMinorHeadingGap": "1.4em",
    "proseIndent": "1.1em",
    "proseListGap": "0.35em",
    "proseRuleGap": "1.8em",
    "proseTablePadding": "6px 12px 6px 0",
    "ruleInlineGap": "0.9em",
    "ruleInset": "1.2em",
    "selectIndicatorPadding": "2.2em",
    "selectGap": "0.7em",
    "pickerPadding": "6px",
    "pickerOffset": "6px",
    "optionPadding": "7px 12px",
    "sliderFieldGap": "5px",
    "sliderTickGap": "2px",
    "statGap": "5px",
    "statUnitGap": "0.15em",
    "statDeltaGap": "0.35em",
    "statGroupGap": "28px",
    "statStackPadding": "14px 0",
    "statusGap": "0.55em",
    "statusBlockPadding": "26px 0",
    "tableHeadPadding": "8px 14px 8px 0",
    "tableCellPadding": "9px 14px 9px 0",
    "tooltipPadding": "5px 9px",
    "tooltipOffset": "7px"
  },
  "motion": {
    "draw": {
      "duration": "1s",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "pop": {
      "duration": "0.5s",
      "easing": "cubic-bezier(.2,.7,.3,1.3)"
    },
    "fade": {
      "duration": "0.9s",
      "easing": "ease"
    },
    "revealThreshold": 0.3,
    "control": {
      "duration": "160ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "toggle": {
      "duration": "140ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "mark": {
      "duration": "140ms",
      "easing": "cubic-bezier(.2,.7,.3,1.3)"
    },
    "press": {
      "duration": "120ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "surface": {
      "duration": "180ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "disclosure": {
      "duration": "200ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "progress": {
      "duration": "320ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "tooltip": {
      "duration": "140ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    }
  }
}
