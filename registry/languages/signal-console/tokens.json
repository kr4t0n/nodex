{
  "$comment": "Canonical language values. The registry build generates tokens.css; primitives and charts consume its semantic variables directly.",
  "color": {
    "bg": "#0B0E13",
    "surface": "#12161D",
    "ink": "#D7DEE8",
    "muted": "#8A94A3",
    "onDarkFaint": "#8A94A3",
    "onDarkMuted": "#8A94A3",
    "faint": "#5A6472",
    "grid": "#1E242E",
    "accent": "#4DD4A8",
    "ok": "#4DD4A8",
    "warn": "#E3B341",
    "crit": "#F0616D",
    "withinObjective": "#2FA37C",
    "border": "#1E242E",
    "actionFill": "#D7DEE8",
    "actionText": "#0B0E13",
    "actionBorder": "#D7DEE8",
    "actionHoverFill": "#8A94A3",
    "actionHoverBorder": "#8A94A3",
    "surfaceFill": "#0B0E13",
    "fieldFill": "#0B0E13",
    "selectionFill": "#D7DEE8",
    "selectionText": "#0B0E13",
    "badgeFill": "#D7DEE8",
    "badgeText": "#0B0E13",
    "valueFill": "#D7DEE8",
    "valueQuietFill": "#8A94A3"
  },
  "ramp": {
    "$comment": "Preserved language colors, including the endpoint chart's original within-objective paint.",
    "steps": [
      "#0B0E13",
      "#12161D",
      "#1E242E",
      "#5A6472",
      "#8A94A3",
      "#D7DEE8",
      "#4DD4A8",
      "#2FA37C",
      "#E3B341",
      "#F0616D"
    ]
  },
  "stroke": {
    "$comment": "Where mono-editorial caps a line at 1.4px, this floors it at 1px and reads at 2px. A console is legible at a glance across a room, which a sub-pixel hairline is not. Marks are filled far more often than they are stroked.",
    "scale": [
      "1px",
      "1.5px",
      "2px",
      "3px",
      "4px"
    ],
    "hairline": "1px",
    "mark": "2px",
    "emphasis": "3px",
    "lineMax": "4px",
    "bandExempt": true
  },
  "radius": {
    "$comment": "Cards and ordinary controls share 3px corners. The checkbox, code, tooltip and focus roles preserve their previous shared-primitive values; they are independently customizable exceptions, not chart-container defaults.",
    "card": "3px",
    "pill": "3px",
    "checkbox": "3px",
    "code": "4px",
    "tooltip": "6px",
    "focus": "2px",
    "avatar": "1px"
  },
  "font": {
    "$comment": "`sans` deliberately resolves to the mono stack. Every primitive references --nx-font-sans, so pointing it at a monospace face is what makes the shared components read as console rather than as mono-editorial wearing dark paint. If a future language wants both faces it can split them again.",
    "sans": "'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "weights": [
      400,
      500,
      600,
      700
    ],
    "faces": [
      {
        "package": "@fontsource-variable/jetbrains-mono@5.3.0",
        "file": "files/jetbrains-mono-latin-wght-normal.woff2",
        "family": "JetBrains Mono",
        "weight": "100 800",
        "style": "normal"
      }
    ],
    "weight": {
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "heading": "'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
    "ui": "'JetBrains Mono', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
  },
  "type": {
    "$comment": "Small and dense. Chart and Card-title roles use zero or positive tracking. Newly tokenized shared-primitive roles preserve their previous values, including Prose and Stat tracking; these are exceptions to the chart scale.",
    "pageTitle": {
      "size": "18px",
      "weight": 700,
      "tracking": "0"
    },
    "cardTitle": {
      "size": "12px",
      "weight": 600,
      "tracking": "0.02em"
    },
    "subtitle": {
      "size": "10.5px",
      "weight": 400,
      "color": "muted",
      "lineHeight": 1.5
    },
    "note": {
      "size": "10.5px",
      "lineHeight": 1.6
    },
    "legend": {
      "size": "9px",
      "weight": 600,
      "tracking": "0.08em"
    },
    "caption": {
      "size": "9px",
      "weight": 500,
      "tracking": "0.1em"
    },
    "axis": {
      "size": "9px",
      "weight": 500
    },
    "action": {
      "size": "11.5px",
      "weight": 600,
      "tracking": "0.01em",
      "lineHeight": 1
    },
    "control": {
      "size": "12px",
      "lineHeight": 1.4,
      "multilineLineHeight": 1.65
    },
    "label": {
      "size": "9px",
      "weight": 700,
      "tracking": "0.08em"
    },
    "body": {
      "size": "11.5px",
      "lineHeight": 1.7
    },
    "help": {
      "size": "10.5px",
      "lineHeight": 1.5
    },
    "badge": {
      "lineHeight": 1.6
    },
    "disclosure": {
      "size": "12.5px",
      "weight": 600,
      "lineHeight": 1.5,
      "bodyLineHeight": 1.75
    },
    "emptyTitle": {
      "size": "15px"
    },
    "avatar": {
      "size": "10px",
      "smallSize": "8px",
      "largeSize": "13px",
      "countSize": "9px",
      "tracking": "0.04em"
    },
    "code": {
      "inlineSize": "0.88em",
      "keySize": "0.82em",
      "keyLineHeight": 1.5,
      "blockSize": "11px",
      "blockLineHeight": 1.7,
      "commandSize": "11.5px",
      "commandLineHeight": 1.6
    },
    "prose": {
      "size": "12.5px",
      "lineHeight": 1.75,
      "titleSize": "19px",
      "titleWeight": 800,
      "headingTracking": "-0.02em",
      "sectionSize": "13px",
      "sectionTracking": "0.06em",
      "subheadingSize": "12.5px",
      "minorHeadingSize": "12px",
      "narrowSize": "11px",
      "narrowLineHeight": 1.7
    },
    "stat": {
      "size": "26px",
      "smallSize": "18px",
      "largeSize": "38px",
      "tracking": "-0.03em",
      "smallTracking": "-0.02em",
      "largeTracking": "-0.035em",
      "lineHeight": 1.05,
      "unitSize": "0.55em",
      "deltaSize": "10.5px"
    },
    "status": {
      "size": "11px",
      "lineHeight": 1.4
    },
    "tooltip": {
      "size": "10.5px",
      "weight": 500,
      "lineHeight": 1.45,
      "tracking": "0.01em"
    },
    "choice": {
      "size": "12px",
      "lineHeight": 1.4,
      "weight": 400
    },
    "uiLabel": {
      "size": "9px",
      "weight": 700,
      "tracking": "0.08em",
      "transform": "uppercase"
    },
    "meterLabel": {
      "size": "9px",
      "weight": 500,
      "tracking": "0.1em",
      "transform": "uppercase"
    }
  },
  "space": {
    "$comment": "Roughly half of mono-editorial at every step. Airy is that language's signature; packed is this one's.",
    "cardPadding": "14px 16px 12px",
    "gridGap": "10px",
    "pagePadding": "20px",
    "fieldGap": "6px",
    "controlPadding": "0.6em 0.95em",
    "textareaPadding": "0.7em 0.95em",
    "actionPadding": "0.55em 1.1em",
    "actionGap": "0.5em",
    "quietActionPaddingInline": "0.5em",
    "compactActionPadding": "0.5em 1em",
    "choiceGap": "0.65em",
    "choiceGroupGap": "0.7em",
    "choiceRowGap": "1.1em",
    "choiceSpreadGap": "1.5em",
    "labelValueGap": "1em",
    "badgePadding": "3px 10px",
    "badgeGap": "0.4em",
    "cardBodyGap": "14px",
    "captionGap": "12px",
    "subtitleGap": "3px",
    "alertPadding": "12px 0 12px 14px",
    "alertGap": "0.35em",
    "avatarOverlap": "8px",
    "inlineCodePadding": "0.15em 0.4em",
    "keyPadding": "0.1em 0.4em",
    "codeBlockPadding": "14px 16px",
    "commandPadding": "0.55em 0.9em",
    "commandGap": "0.8em",
    "disclosurePadding": "12px 0",
    "disclosureGap": "0.8em",
    "disclosureBodyPadding": "0 0 16px",
    "dialogBodyPadding": "22px 24px 20px",
    "dialogActionsPadding": "14px 24px",
    "dialogGap": "8px",
    "emptyPadding": "30px 28px",
    "emptyCenteredPadding": "52px 28px",
    "emptyQuietPadding": "20px 0",
    "emptyGap": "10px",
    "emptyActionGap": "4px",
    "linkUnderlineOffset": "0.22em",
    "linkIconGap": "0.35em",
    "proseFlowGap": "0.9em",
    "proseSectionGap": "2em",
    "proseSubheadingGap": "1.6em",
    "proseMinorHeadingGap": "1.4em",
    "proseIndent": "1.1em",
    "proseListGap": "0.35em",
    "proseRuleGap": "1.8em",
    "proseTablePadding": "6px 12px 6px 0",
    "ruleInlineGap": "0.9em",
    "ruleInset": "1.2em",
    "selectIndicatorPadding": "2.2em",
    "selectGap": "0.7em",
    "pickerPadding": "6px",
    "pickerOffset": "6px",
    "optionPadding": "7px 12px",
    "sliderFieldGap": "5px",
    "sliderTickGap": "2px",
    "statGap": "5px",
    "statUnitGap": "0.15em",
    "statDeltaGap": "0.35em",
    "statGroupGap": "28px",
    "statStackPadding": "14px 0",
    "statusGap": "0.55em",
    "statusBlockPadding": "26px 0",
    "tableHeadPadding": "8px 14px 8px 0",
    "tableCellPadding": "9px 14px 9px 0",
    "tooltipPadding": "5px 9px",
    "tooltipOffset": "7px"
  },
  "motion": {
    "$comment": "Fast state changes. Looping tokens are available only for genuinely live state, always subject to reduced motion.",
    "draw": {
      "duration": "0.35s",
      "easing": "cubic-bezier(.2,0,0,1)"
    },
    "pop": {
      "duration": "0.2s",
      "easing": "cubic-bezier(.2,.7,.3,1.2)"
    },
    "pulse": {
      "duration": "1.6s",
      "easing": "ease-in-out",
      "loops": true
    },
    "sweep": {
      "duration": "2.4s",
      "easing": "linear",
      "loops": true
    },
    "revealThreshold": 0.15,
    "control": {
      "duration": "160ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "toggle": {
      "duration": "140ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "mark": {
      "duration": "140ms",
      "easing": "cubic-bezier(.2,.7,.3,1.3)"
    },
    "press": {
      "duration": "120ms",
      "easing": "cubic-bezier(.4,0,.2,1)",
      "x": "0px",
      "y": "1px"
    },
    "surface": {
      "duration": "180ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "disclosure": {
      "duration": "200ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "progress": {
      "duration": "320ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    },
    "tooltip": {
      "duration": "140ms",
      "easing": "cubic-bezier(.4,0,.2,1)"
    }
  },
  "shadow": {
    "$comment": "Geometry only. Primitives apply scoped ink directly so descendant paint overrides also recolor shadows. Zero offsets preserve this language’s flat surfaces.",
    "action": "0px 0px 0px",
    "actionPressed": "0px 0px 0px",
    "control": "0px 0px 0px",
    "badge": "0px 0px 0px",
    "surface": "0px 0px 0px",
    "popover": "0px 0px 0px"
  },
  "texture": {
    "outlineOpacity": 0,
    "outlineInset": "1px 2px 2px 1px",
    "outlineRadius": "7px 4px 8px 3px / 3px 8px 4px 7px",
    "hatchOpacity": 0,
    "hatchSize": "24px",
    "hatchGap": "5px",
    "hatchAngle": "-41deg"
  }
}
