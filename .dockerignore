# Keep the build context small and force generated artifacts to be regenerated
# inside the image rather than shipped from whichever machine ran docker build.

node_modules
**/node_modules

# Next output, including a standalone tree from a local build.
.next
**/.next

# Generated by build-registry.mjs and sync-registry-public.mjs. Rebuilt in the
# image, so sending a local copy would only risk baking in a stale one.
public/r
apps/web/public
registry/**/index.html
registry/languages/*/tokens.css

# Secrets. The image takes configuration at run time, and a .env copied in here
# would be baked into a layer and shipped to a registry.
.env
.env.*
!.env.example

.git
.github
.agents
tmp
*.log
.DS_Store

# Documentation and tooling the runtime does not need.
skills
docker-compose.yml
